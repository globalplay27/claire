NODE_ENV=development
PORT=3000

# OpenAI — necessário para os agentes de planejamento/criação/imagem
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-1

# Meta / Instagram API
# Para Instagram Login, use a chave secreta exibida na configuração da API do Instagram.
INSTAGRAM_APP_SECRET=
# Opcional: chave secreta do app Meta/Facebook para fluxos legados.
META_APP_SECRET=
META_VERIFY_TOKEN=troque-por-um-token-secreto-longo
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_API_VERSION=v26.0

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claire
DATABASE_SSL=false

# Handoff humano
HUMAN_HANDOFF_URL=

# Gatilhos separados por vírgula
LEAD_KEYWORDS=quero,preço,preco,valor,teste,saiba mais

# Automação multiagente
AUTOMATION_ENABLED=false
AUTOMATION_POLL_SECONDS=60
AUTOMATION_ADMIN_TOKEN=troque-por-um-token-admin-longo
AUTO_POST_HOURS=18
PUBLIC_BASE_URL=
BRAND_NAME=Global Play
BRAND_INSTAGRAM=@globalplay_streaming
BRAND_WHATSAPP_URL=
BRAND_OBJECTIVE=atrair assinantes e revendedores com conteúdo claro, útil e comercial
